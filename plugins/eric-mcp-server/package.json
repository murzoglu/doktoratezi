{
  "name": "eric-mcp-server",
  "version": "1.2.0",
  "description": "Remote MCP server for the ERIC education research database on Cloudflare Workers.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "validate:upstream": "node scripts/validate-upstream.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.0.8",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "wrangler": "4.118.0"
  }
}
