# Local editor and OS state
.vscode/
.DS_Store
Thumbs.db

# Logs and transient debug output
*.log
firebase-debug.log

# Office temporary lock files
~$*
*.tmp

# Timestamped hook/config backup droppings (e.g. foo.py.bak.1782821158)
*.bak.[0-9]*

# Python generated files
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Secrets — never commit (ZOTERO_API_KEY, GROK_API_KEY, ...)
.env
.env.*
.claude/*.local.md
.claude/*.local.json

# Codex / agent tooling for this repo
.claude/settings.local.json
!.codex/
!.codex/hooks/
!.codex/tools/
!.codex/hooks.json
!.agents/
!.agents/plugins/
!.agents/plugins/marketplace.json
!plugins/
!plugins/t1dm-qual-ai-audit/
!plugins/t1dm-qual-ai-audit/**
plugins/**/__pycache__/
plugins/**/*.py[cod]

# Sensitive qualitative research data boundaries
00_context/file_manifest_*.tsv
00_context/reorg_move_log.tsv
00_raw_locked/
01_raw_data/
01_deidentified/
02_processed/cleaned_text/
02_processed/transcripts/
.remember/
03_analysis/spreadsheets/
03_analysis/thematic_memos/
03_analysis/triadic_matrices/
04_triadic_matrices/
04_manuscripts/
05_references/literature/
06_tools/reports/
06_manuscript_outputs/quotes_used*.csv
99_archive/

# Serena code-navigation MCP: commit project.yml only; ignore runtime state
.serena/cache/
.serena/logs/
.serena/memories/
