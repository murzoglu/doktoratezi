{
  "_comment": "Doktoratezi — Claude Code AI-reliability katmanı. Codex ikizi: .codex/hooks.json + .codex/hooks/. Politika değişiklikleri iki ağaca birlikte işlenir; tests/test_claude_hooks.py bu yüzeyi korur. Üç-katmanlı veri-yönetişimi (owner onaylı revizyon 2026-07-13): (1) PII/ön-temizlik kaynak dosyaları (data/raw|identified|cleaned|backup) ve credential'lar okuma/erişime KAPALI; (2) de-identified analiz yüzeyi (data/processed işlenmiş kanonik baz + outputs aggregate çıktı) owner onayıyla Read + R/python hesaplamasına AÇIK — de-identifikasyon Stage 1'de tamamlanır; (3) kanonik bazın Edit ile elle değiştirilmesi (Edit data/**), _targets store okuması ve verinin dışa-kopyalanması (pre_tool_use exfil kuralı) KAPALI. Nitel kol (niteliksel/.claude) ayrı ve dokunulmadı.",
  "permissions": {
    "deny": [
      "Read(./data/raw/**)",
      "Read(./data/identified/**)",
      "Read(./data/cleaned/**)",
      "Read(./data/backup/**)",
      "Read(./_targets/**)",
      "Edit(./data/**)",
      "Edit(./_targets/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/client_secret*)",
      "Read(./**/credentials*)",
      "Read(./**/dr-murzoglu-doktora.json)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 30,
            "statusMessage": "Loading reliability conventions + talimatname"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/user_prompt_submit.py\"",
            "timeout": 15,
            "statusMessage": "Scanning prompt for secrets"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_use_policy.py\"",
            "timeout": 15,
            "statusMessage": "Checking command against data-governance deny-list"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_tool_use_review.py\"",
            "timeout": 15,
            "statusMessage": "Reviewing tool output"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_tool_use_review.py\"",
            "timeout": 200,
            "statusMessage": "references.bib düzenlendiyse bib hijyen kapısı"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_verify.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
